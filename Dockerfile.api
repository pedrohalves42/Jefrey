# Imagem do Jefrey FastAPI Server (Fase P5).
# Serviço paralelo ao MCP Server (porta 8000 vs 8001).
# Mesma base do Dockerfile.mcp — dependências instaladas no build (cacheadas).
# O código é montado via volume (.:/app) em runtime.
FROM python:3.12-slim

WORKDIR /app

# SECURITY (P0.5): usuário não-root — evita que exploit no container dê root no host
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libsndfile1 && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1001 jefrey \
    && useradd --uid 1001 --gid 1001 --no-create-home --shell /bin/false jefrey \
    && chown -R jefrey:jefrey /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Ajustar permissões antes de trocar usuário
RUN chown -R jefrey:jefrey /app

# Trocar para usuário sem privilégios
USER jefrey

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" \
  || exit 1

CMD ["python", "-m", "src.jefrey.api"]
