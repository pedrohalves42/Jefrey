          "expr": "histogram_quantile(0.95, sum(rate(jefrey_stt_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "STT p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(jefrey_tts_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "TTS p95",
          "refId": "B"
        }
      ]
    }
