    {
      "title": "Kid Legacy (10m)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "increase(jefrey_eventbus_kid_legacy_total[10m])",
          "legendFormat": "Legacy v0",
          "refId": "A"
        }
      ]
    },
    {
      "title": "API Error Rate (5m)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(jefrey_tools_blocked_total[5m])) / clamp_min(sum(rate(jefrey_tool_exec_latency_seconds_count[5m])), 1)",
          "legendFormat": "ErrorRate",
          "refId": "A"
        }
      ]
    },
    {
      "title": "RateLimit Deny Rate (5m)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(jefrey_rate_limit_total{decision=\"deny\"}[5m])) / clamp_min(sum(rate(jefrey_rate_limit_total[5m])), 1)",
          "legendFormat": "DenyRatio",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Memory p95 Latency",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(jefrey_memory_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(jefrey_memory_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Tools Blocked (1h)",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (tool_name) (increase(jefrey_tools_blocked_total[1h]))",
          "legendFormat": "{{tool_name}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "Approvals HITL (1h)",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (tool_name, risk_level) (increase(jefrey_approvals_created_total[1h]))",
          "legendFormat": "Created: {{tool_name}} ({{risk_level}})",
          "refId": "A",
          "instant": true
        },
        {
          "expr": "sum by (tool_name, decision) (increase(jefrey_approvals_decided_total[1h]))",
          "legendFormat": "Decided: {{tool_name}} ({{decision}})",
          "refId": "B",
          "instant": true
        }
      ]
    },
    {
      "title": "STT Latency p95",
