# ============================================
# JEFREY - Configurações de Ambiente
# Perfil DEV local:  python scripts/setup.py --dev --non-interactive --force  (ollama/768, postgres jefrey)
# Perfil PROD:       python scripts/setup.py --non-interactive --force       (openai/1536, senha forte)
# Após --dev + docker compose down -v && up -d, o DB usa a senha do .env via env_file
# Copie este arquivo para .env e preencha suas chaves
# ============================================

# -----------------------------------------------------------------------------
# APLICAÇÃO
# -----------------------------------------------------------------------------
JEFREY_DEBUG=true
JEFREY_LOG_LEVEL=INFO
JEFREY_USER_NAME=Usuário

# -----------------------------------------------------------------------------
# n8n (Fase P3b — Event Router) — Basic Auth da UI/API/webhooks
# -----------------------------------------------------------------------------
N8N_BASIC_AUTH_USER=jefrey
# CIPHER-116: PROD exige senha forte; compose falha sem :?required — troque antes de subir em prod
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_IN_PROD__TROQUE_ANTES_DO_PROD
# Chave de API para automação (n8n 2.x REST API exige API key)
N8N_API_KEY=CHANGE_ME_IN_PROD

# -----------------------------------------------------------------------------
# LLM - Escolha UM provider
# -----------------------------------------------------------------------------
# OpenAI / Azure / Endpoints compatíveis (LM Studio, vLLM, Ollama server, etc)
JEFREY_LLM__PROVIDER=openai
JEFREY_LLM__MODEL=gpt-4o-mini
JEFREY_LLM__TEMPERATURE=0.7
JEFREY_LLM__MAX_TOKENS=4000
JEFREY_LLM__API_KEY=sk-sua-chave-aqui
# IMPORTANTE: base_url SEM /v1 no final!
# Exemplos:
# OpenAI:          https://api.openai.com/v1
# Azure:           https://SEU_RECURSO.openai.azure.com
# LM Studio:       http://127.0.0.1:1234
# Ollama (server): http://127.0.0.1:11434
# vLLM:            http://127.0.0.1:8000
# JEFREY_LLM__BASE_URL=https://api.openai.com/v1

# Anthropic (Claude)
# JEFREY_LLM__PROVIDER=anthropic
# JEFREY_LLM__MODEL=claude-3-5-sonnet-20241022
# JEFREY_LLM__API_KEY=sk-ant-sua-chave

# Ollama nativo (local)
# JEFREY_LLM__PROVIDER=ollama
# JEFREY_LLM__MODEL=llama3.1:8b
# JEFREY_LLM__BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# MEMÓRIA
# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL + pgvector) — Fase P1
JEFREY_DATABASE__URL=postgresql+psycopg://jefrey:jefrey@localhost:5432/jefrey
JEFREY_DATABASE__POOL_SIZE=10
JEFREY_DATABASE__MAX_OVERFLOW=20

# Redis (working memory / cache de sessão) — Fase P1
JEFREY_REDIS__URL=redis://localhost:6379/0

# Memória de longo prazo: escolha 'chromadb' ou 'postgres'/'postgresql'
JEFREY_MEMORY__LONG_TERM__PROVIDER=postgres
JEFREY_MEMORY__LONG_TERM__PERSIST_DIRECTORY=data/chroma_db
JEFREY_MEMORY__LONG_TERM__COLLECTION_NAME=jefrey_memory
JEFREY_MEMORY__LONG_TERM__EMBEDDING_MODEL=text-embedding-3-small
JEFREY_MEMORY__LONG_TERM__EMBEDDING_DIM=1536
JEFREY_MEMORY__LONG_TERM__TOP_K=5
JEFREY_MEMORY__LONG_TERM__SIMILARITY_THRESHOLD=0.7

JEFREY_MEMORY__SHORT_TERM__MAX_MESSAGES=20
JEFREY_MEMORY__SHORT_TERM__MAX_TOKENS=8000

# -----------------------------------------------------------------------------
# VOICE (Opcional)
# -----------------------------------------------------------------------------
JEFREY_VOICE__ENABLED=false
JEFREY_VOICE__WAKE_WORD__ENABLED=false
JEFREY_VOICE__WAKE_WORD__PROVIDER=porcupine
JEFREY_VOICE__WAKE_WORD__ACCESS_KEY=sua-chave-picovoice
JEFREY_VOICE__WAKE_WORD__KEYWORDS=["jefrey"]

JEFREY_VOICE__STT__PROVIDER=whisper
JEFREY_VOICE__STT__MODEL=base
JEFREY_VOICE__STT__LANGUAGE=pt

JEFREY_VOICE__TTS__PROVIDER=piper
JEFREY_VOICE__TTS__VOICE=pt_BR-faber-medium
JEFREY_VOICE__TTS__SPEED=1.0

# -----------------------------------------------------------------------------
# INTEGRAÇÕES - GOOGLE (OAuth necessário)
# -----------------------------------------------------------------------------
JEFREY_INTEGRATIONS__GOOGLE_CALENDAR__ENABLED=false
JEFREY_INTEGRATIONS__GOOGLE_CALENDAR__CREDENTIALS_FILE=config/credentials/google_calendar.json
JEFREY_INTEGRATIONS__GOOGLE_CALENDAR__TOKEN_FILE=config/tokens/google_calendar_token.json

JEFREY_INTEGRATIONS__GMAIL__ENABLED=false
JEFREY_INTEGRATIONS__GMAIL__CREDENTIALS_FILE=config/credentials/gmail.json
JEFREY_INTEGRATIONS__GMAIL__TOKEN_FILE=config/tokens/gmail_token.json

JEFREY_INTEGRATIONS__GOOGLE_DRIVE__ENABLED=false
JEFREY_INTEGRATIONS__GOOGLE_DRIVE__CREDENTIALS_FILE=config/credentials/google_drive.json
JEFREY_INTEGRATIONS__GOOGLE_DRIVE__TOKEN_FILE=config/tokens/google_drive_token.json

# -----------------------------------------------------------------------------
# INTEGRAÇÕES - OUTRAS
# -----------------------------------------------------------------------------
JEFREY_INTEGRATIONS__NOTION__ENABLED=false
JEFREY_INTEGRATIONS__NOTION__TOKEN=secret_xxx

JEFREY_INTEGRATIONS__COMPOSIO__ENABLED=false
JEFREY_INTEGRATIONS__COMPOSIO__API_KEY=sua-chave-composio

# -----------------------------------------------------------------------------
# SKILLS - Habilitar/Desabilitar
# -----------------------------------------------------------------------------
JEFREY_SKILLS__CALENDAR=true
JEFREY_SKILLS__EMAIL=true
JEFREY_SKILLS__WEB_SEARCH=true
JEFREY_SKILLS__NOTES=true
JEFREY_SKILLS__AUTOMATION=true
JEFREY_SKILLS__DRIVE=true
JEFREY_SKILLS__WEATHER=false
JEFREY_SKILLS__STOCKS=false

# -----------------------------------------------------------------------------
# APIS EXTERNAS
# -----------------------------------------------------------------------------
# Tavily para busca web (obrigatório para web_search)
TAVILY_API_KEY=tvly-sua-chave-aqui
JEFREY_TAVILY__API_KEY=tvly-sua-chave-aqui  # alias com prefixo JEFREY (Pydantic)

# OpenAI para embeddings (se usar text-embedding-3-small)
OPENAI_API_KEY=sk-sua-chave-aqui

# ElevenLabs para TTS premium (opcional)
ELEVENLABS_API_KEY=sua-chave-elevenlabs

# Picovoice para wake word (opcional)
PICOVOICE_ACCESS_KEY=sua-chave-picovoice

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
JEFREY_LOGGING__LEVEL=INFO
JEFREY_LOGGING__FILE=logs/jefrey.log
JEFREY_LOGGING__FORMAT=%(asctime)s | %(levelname)-8s | %(name)s | %(message)s

# -----------------------------------------------------------------------------
# SEGURANCA / HITL / POLICY (CIPHER-019,002,001,018,025) - Etapa 6.3
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
JEFREY_API__SECRET_KEY=CHANGE_ME_GENERATE_HEX32
JEFREY_API__AUDIT_FALLBACK_PATH=data/audit_fallback.jsonl

JEFREY_DATABASE__PASSWORD=CHANGE_ME_STRONG
JEFREY_REDIS__PASSWORD=CHANGE_ME_STRONG
JEFREY_REDIS__MAX_CONNECTIONS=50
# ---------------------------------------------------------------------------
# FASE2 — Seguranca / OAuth2 / EventBus (fail-closed em prod)
# Gere HMAC: python -c "import secrets; print(secrets.token_hex(32))"
# Gere kids: kid=v1 -> {"v1":"<hex32>","v2":"<hex32>"} para rotacao dual-verify
# ---------------------------------------------------------------------------
JEFREY_ENV=dev
JEFREY_EVENTBUS__HMAC_KEY=CHANGE_ME_GENERATE_HEX32_MIN32CHARS
JEFREY_EVENTBUS__HMAC_KEYS_JSON={"v1":"CHANGE_ME_HEX32_MIN32CHARS____________"}
JEFREY_EVENTBUS__HMAC_KID=v1
JEFREY_OAUTH__CLIENT_ID=CHANGE_ME
JEFREY_OAUTH__CLIENT_SECRET=CHANGE_ME
JEFREY_OAUTH__TOKEN_URI=https://auth.example.com/oauth/token
JEFREY_OAUTH__AUD=jefrey
JEFREY_OAUTH__ISS=https://auth.jefrey.ai
JEFREY_OAUTH__JWKS_URI=https://auth.jefrey.ai/.well-known/jwks.json
JEFREY_OAUTH__REDIRECT_URIS=http://localhost:8000/oauth/callback
JEFREY_API__CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# GRAFANA_PASSWORD moved to FASE2 block

JEFREY_POLICY__MODE=enforce
JEFREY_POLICY__RATE_LIMIT_MAX=20
JEFREY_POLICY__RATE_LIMIT_WINDOW=60.0
JEFREY_HITL__APPROVAL_TTL=1800
JEFREY_HITL__POLL_INTERVAL=2.0

JEFREY_AGENT__PROVIDER=langgraph
JEFREY_AGENT__OPENAI_API_KEY=
JEFREY_AGENT__OPENAI_BASE_URL=
JEFREY_AGENT__OPENAI_MODEL=gpt-4o-mini

JEFREY_MCP__HOST=0.0.0.0
JEFREY_MCP__PORT=8001
JEFREY_MCP__TRANSPORT=streamable-http
JEFREY_MCP__JSON_RESPONSE=true
JEFREY_MCP__STATELESS_HTTP=true
JEFREY_MCP__SERVICE_ROLE=user
JEFREY_MCP__ALLOWED_ROLES=["user"]
JEFREY_MCP__TOOL_TIMEOUT=30.0

JEFREY_MCP_CLIENT__ENABLED=false

# Grafana (observabilidade P6)
GRAFANA_PASSWORD=CHANGE_ME
