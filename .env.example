# JEFREY .env Example â€” Stark-mode Production Ready
# Base 175/175 | Phase 8: Observability & Deploy | Axiom #1-7 + CIPHER 025-035

# ===== IDENTIDADE =====
JEFREY_USER_NAME=UsuÃ¡rio
JEFREY_ENV=dev

# ===== OAUTH2 / OPENID CONNECT (CIPHER-031) =====
# Variaveis planas â€” exigidas pela validacao profunda
JEFREY_OAUTH__AUD=sua_aud_aqui
JEFREY_OAUTH__ISS=sua_iss_aqui
JEFREY_OAUTH__TOKEN_URI=https://oauth2.googleapis.com/token

# Credenciais Google OAuth2 â€” obter no Google Cloud Console
# ===== OAuth2 Google (CIPHER-031) =====
# Obtenha credenciais em: https://console.cloud.google.com/
# Veja o guia completo em: docs/OAUTH2_GOOGLE_SETUP.md
JEFREY_OAUTH__GOOGLE__CLIENT_ID=seu_client_id_aqui
JEFREY_OAUTH__GOOGLE__CLIENT_SECRET=seu_client_secret_aqui

# Alias para compatibilidade com o código existente
JEFREY_OAUTH__CLIENT_ID=seu_client_id_aqui
JEFREY_OAUTH__CLIENT_SECRET=seu_client_secret_aqui

# Redirect URI (deve coincidir com o configurado no Google Console)
JEFREY_OAUTH__REDIRECT_URIS=http://localhost:8000/auth/google/callback

# Token de refresh para OAuth (apenas dev; em prod use flow completo)
JEFREY_OAUTH__REFRESH_TOKEN=refresh_token_aqui

# Outros parâmetros OAuth2
JEFREY_OAUTH__AUD=jefrey
JEFREY_OAUTH__ISS=https://accounts.google.com
JEFREY_OAUTH__TOKEN_URI=https://oauth2.googleapis.com/token
JEFREY_OAUTH__JWKS_URI=https://www.googleapis.com/oauth2/v3/certs

# ===== CORS (CIPHER-025) =====
JEFREY_API__CORS_ORIGINS=localhost,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176,http://localhost:5177,http://127.0.0.1:5177,http://localhost:5178,http://127.0.0.1:5178,http://localhost:5179,http://127.0.0.1:5179,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# ===== REDIS (CIPHER-025) =====
# Nunca deve estar vazio em producao â€” evita acesso nao autorizado ao Redis compartilhado
JEFREY_REDIS__PASSWORD=jefrey
JEFREY_DATABASE__PASSWORD=jefrey

# ===== DATABASE (PostgreSQL + pgvector) =====
JEFREY_DATABASE_URL=postgres://jefrey:sua_senha_postgres@postgres:5432/jefrey

# ===== API SECRET =====
JEFREY_API__SECRET_KEY=sua_chave_secreta_aqui

# ===== EVENT BUS =====
JEFREY_EVENTBUS__HMAC_KEY=sua_chave_hmac_aqui
# HMAC key versioning for kid rotation (CIPHER-031)
# Allows dual-key support: v1 (current) and v2 (previous) for seamless rotation
JEFREY_EVENTBUS__HMAC_KEYS_JSON='{"keys": [{"kid": "v1", "key": "sua_chave_aqui"}, {"kid": "v2", "key": "sua_outra_chave_aqui"}]}
JEFREY_EVENTBUS__HMAC_KEYS_JSON=
JEFREY_EVENTBUS__HMAC_KID=v1

# ===== MCP =====
JEFREY_MCP__HOST=0.0.0.0
JEFREY_MCP__PORT=8001
JEFREY_MCP__TRANSPORT=streamable-http
JEFREY_MCP__JSON_RESPONSE=true
JEFREY_MCP__STATELESS_HTTP=true
JEFREY_MCP__SERVICE_ROLE=user
JEFREY_MCP__ALLOWED_ROLES=["user"]
JEFREY_MCP__TOOL_TIMEOUT=30.0

# ===== MCP OAuth 2.0 (P3b) =====
# Habilitar OAuth 2.0 Resource Server no MCP Gateway
JEFREY_MCP_OAUTH_ENABLED=false
# Tokens de acesso validos (comma-separated) - em producao usar JWT/introspection
JEFREY_MCP_OAUTH_TOKENS=dev-token-change-me-in-production
JEFREY_MCP_CACHE_TTL=300  # Discovery cache TTL em segundos (BUG-P3a-01)
# Tokens OAuth para MCPClient conectar a servidores externos (kid rotation)
JEFREY_MCP_CLIENT_TOKENS=  # comma-separated, vazio = sem OAuth client

# ===== n8n Bridge (P3b Diff 4) =====
JEFREY_N8N_BASE_URL=http://jefrey-n8n:5678  # URL base do n8n
JEFREY_N8N_MCP_URL=  # URL do MCP Server do n8n (vazio = webhook only)
JEFREY_N8N_BRIDGE_MODE=auto  # auto | mcp | webhook

# ===== LLM CONFIG =====
JEFREY_AVATAR__MODEL=data/avatars/iron_man.glTF
JEFREY_VOICE__ENABLED=true
JEFREY_VOICE__STT__PROVIDER=whisper
JEFREY_VOICE__STT__MODEL=small
JEFREY_VOICE__TTS__PROVIDER=piper
# JEFREY_TTS__API_KEY / ELEVENLABS_API_KEY para elevenlabs (opcional)
JEFREY_LLM__PROVIDER=ollama
JEFREY_LLM__MODEL=qwen2.5:1.5b
JEFREY_LLM__BASE_URL=http://ollama:11434
JEFREY_EMBEDDINGS__BASE_URL=http://ollama:11434
JEFREY_LLM__TEMPERATURE=0.7
JEFREY_LLM__MAX_TOKENS=4000

# ===== OBSERVABILIDADE (Phase 8) =====
PROMETHEUS_LISTEN_ADDRESS=0.0.0.0:9090
GRAFANA_HTTP_ADDR=http://0.0.0.0:3000
GRAFANA_SECURITY_ADMIN_USER=admin
GRAFANA_SECURITY_ADMIN_PASSWORD=mudar_senha_grafana


# ===== Telemetry / Observability (P6.2 Diff 5) =====
JEFREY_TELEMETRY__ENABLED=false
JEFREY_TELEMETRY__SERVICE_NAME=jefrey-mcp
JEFREY_TELEMETRY__OTLP_ENDPOINT=  # ex: http://jaeger:4318/v1/traces
JEFREY_TELEMETRY__OTLP_HEADERS=  # JSON: '{"Authorization": "Bearer xxx"}'
JEFREY_TELEMETRY__SAMPLE_RATE=1.0
JEFREY_TELEMETRY__ENABLE_CONSOLE=false
JEFREY_TELEMETRY__METRICS_ENABLED=true
JEFREY_TELEMETRY__METRICS_PATH=/metrics



# ===== Alerting Thresholds (P6.3) =====
JEFREY_ALERTING__HEALTH_CHECK_INTERVAL_SEC=30
JEFREY_ALERTING__SERVICE_DOWN_FOR_SEC=60
JEFREY_ALERTING__TOOL_LATENCY_P95_WARN_SEC=10.0
JEFREY_ALERTING__TOOL_LATENCY_P95_CRIT_SEC=30.0
JEFREY_ALERTING__TOOL_ERROR_RATE_WARN=0.1
JEFREY_ALERTING__THROUGHPUT_DROP_RATIO=0.01
JEFREY_ALERTING__OAUTH_INVALID_RATE_WARN_PER_MIN=10.0
JEFREY_ALERTING__OAUTH_MISSING_RATE_WARN_PER_MIN=20.0
JEFREY_ALERTING__RATE_LIMIT_DENY_RATE_WARN_PER_MIN=5.0
JEFREY_ALERTING__TOOLS_BLOCKED_RATE_WARN_PER_MIN=5.0
JEFREY_ALERTING__HITL_PENDING_ACCUMULATION_WARN=10
JEFREY_ALERTING__CACHE_HIT_RATE_WARN=0.5
JEFREY_ALERTING__BRIDGE_ERROR_RATE_WARN_PER_MIN=2.0
JEFREY_ALERTING__BRIDGE_TIMEOUT_RATE_WARN_PER_MIN=1.0
JEFREY_ALERTING__BRIDGE_HITL_REJECT_RATE_WARN_PER_MIN=0.5
JEFREY_ALERTING__LLM_LATENCY_P95_WARN_SEC=30.0
JEFREY_ALERTING__MEMORY_LATENCY_P95_WARN_SEC=5.0

# ===== DOCKER COMPOSE =====
COMPOSE_PROJECT_NAME=jefrey

